# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info/

# Virtual environments
.venv/

# Local data policy:
# Keep data out of Git except lightweight metadata/message files.
data/**
!data/**/
!data/**/*.jsonl
!data/**/spk2utt
!data/**/text
!data/**/utt2spk
# !data/**/wav.scp

# Large generated data outputs
dump/

# Experiment outputs are synced except heavy model checkpoints and event files.
exp/**/checkpoint/
exp/**/checkpoints/
exp/**/lightning_logs/**/events.out.tfevents.*
exp/**/train*.log
exp/**/*.ckpt
exp/**/*.pt
exp/**/*.pth
exp/**/*.safetensors
exp/**/*.onnx

# Top-level logs remain machine-local.
lightning_logs/
*.ckpt
*.pt
*.pth
*.safetensors
*.onnx
*.log
events.out.tfevents.*

# Machine-local binary wheels and caches
*.whl
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local editor/OS noise
.DS_Store
.idea/
.vscode/
